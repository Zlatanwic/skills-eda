# Optional LLM-assisted SCR annotation.
# Copy this file to `.env` and fill in your key. Do not commit `.env`.
#
# OpenAI-compatible Chat Completions endpoint:
SKILLSCOPE_LLM_BASE_URL=https://api.openai.com/v1
SKILLSCOPE_LLM_API_KEY=sk-your-key-here
SKILLSCOPE_LLM_MODEL=gpt-4.1-mini
# Optional: run LLM-assisted SCR automatically inside scripts/run_pipeline.py.
SKILLSCOPE_LLM_SCR_ENABLE=0
# all = annotate the first filtered records; auto = only annotate records that need SCR quality repair.
SKILLSCOPE_LLM_SCR_SELECTION=auto
# Leave empty to let auto mode consider all sources, or set e.g. skvm.benchmark/public.github.
SKILLSCOPE_LLM_SCR_SOURCE=
# Empty or 0 means no limit; use a small number for quick test runs.
SKILLSCOPE_LLM_SCR_LIMIT=0
SKILLSCOPE_LLM_SCR_MIN_CONFIDENCE=0.55
SKILLSCOPE_LLM_SCR_MIN_RISK=0.25
# Higher means fewer LLM calls. 1.0 usually selects tens of high-value candidates.
SKILLSCOPE_LLM_SCR_MIN_SCORE=1.0
SKILLSCOPE_LLM_SCR_MAX_CHARS=12000

# Optional public skills sampling from GitHub code search.
# A token is recommended because unauthenticated code search is rate limited.
SKILLSCOPE_PUBLIC_GITHUB_TOKEN=github_pat_your_token_here
SKILLSCOPE_PUBLIC_MAX_RESULTS=100
# Optional semicolon-separated GitHub code-search queries.
SKILLSCOPE_PUBLIC_QUERIES=filename:SKILL.md "description";filename:SKILL.md "Use this skill"
# Set to 1 only if you want to try unauthenticated public search.
SKILLSCOPE_PUBLIC_ALLOW_UNAUTHENTICATED=0
